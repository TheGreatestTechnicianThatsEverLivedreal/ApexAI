{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ApexAI: Start Dev Server (Full Stack)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ApexAI: Run Unit Tests",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "console": "integratedTerminal"
    },
    {
      "name": "ApexAI: Launch Python Learner Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learner/learner.py",
      "console": "integratedTerminal"
    },
    {
      "name": "ApexAI: Launch Synthetic Demo Learner",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo/fake_learner.py",
      "console": "integratedTerminal"
    }
  ]
}
